{
  "name": "garment-ims-backend",
  "version": "1.0.0",
  "description": "Garment Inventory & Manufacturing System Backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "npx sequelize-cli db:migrate",
    "seed": "npx sequelize-cli db:seed:all",
    "migrate:undo": "npx sequelize-cli db:migrate:undo",
    "setup-db": "node scripts/setup-db.js",
    "create-admin": "node scripts/create-admin-user.js",
    "seed-basic": "node scripts/seed-basic-data.js",
    "show-credentials": "node scripts/show-admin-credentials.js",
    "reset-db": "npx sequelize-cli db:migrate:undo:all && npm run setup-db",
    "test": "jest"
  },
  "dependencies": {
    "express": "^4.18.2",
    "sequelize": "^6.35.2",
    "mysql2": "^3.6.5",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "dotenv": "^16.3.1",
    "uuid": "^9.0.1",
    "morgan": "^1.10.0",
    "compression": "^1.7.4"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "sequelize-cli": "^6.6.2",
    "jest": "^29.7.0",
    "supertest": "^6.3.3"
  },
  "keywords": ["garment", "inventory", "manufacturing", "ims", "express", "sequelize"],
  "author": "Your Name",
  "license": "MIT"
}